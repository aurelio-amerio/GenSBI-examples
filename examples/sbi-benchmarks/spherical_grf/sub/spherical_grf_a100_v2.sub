# HTCondor submit file — spherical GRF exp-7 (v2 script; architecture frozen
# at exp-6: global bottleneck attention) on A100.
#
#     condor_submit sub/spherical_grf_a100_v2.sub
#
# A100 (40 GB) variant. exp-7 = exp-6 + 8x exact isometry augmentation +
# 300k steps (~27h train; run 6 did 150k in 13.6h), TARP disabled
# (config_healpix_7.yaml). Memory unchanged: ~15 GiB at batch 64.
repo_root   = /lustre/ific.uv.es/ml/ific088/github/GenSBI-examples
example_dir = $(repo_root)/examples/sbi-benchmarks/spherical_grf
config      = config_healpix_7.yaml
script      = train-spherical-grf-v2.py

universe   = vanilla
initialdir = $(example_dir)/sub
executable = $(example_dir)/sub/run_spherical_grf.sh
arguments  = "$(example_dir) $(config) $(script)"
getenv     = True

request_cpus   = 8
request_memory = 32 GB
request_gpus   = 1

+UseNvidiaA100 = True

log    = condor_logs/spherical_grf_$Fn(config)_a100.log
output = condor_logs/spherical_grf_$Fn(config)_a100.out
error  = condor_logs/spherical_grf_$Fn(config)_a100.err

queue
